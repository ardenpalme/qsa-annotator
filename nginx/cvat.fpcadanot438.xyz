# Failed CVAT logins, for fail2ban (fail2ban/):
# - POST /api/auth/login with bad credentials -> 400
# - any request with Basic auth and bad credentials -> 401
# Plain 401s (logged-out SPA calls) are not counted.
map $http_authorization $cvat_basic_auth {
    "~*^basic\s" 1;
    default      0;
}

map "$request_method:$uri:$status:$cvat_basic_auth" $cvat_auth_fail {
    "~^POST:/api/auth/login:400:" 1;
    "~:401:1$"                    1;
    default                       0;
}

log_format cvat_auth '$remote_addr [$time_local] "$request" $status';

server {
    listen 80;
    server_name cvat.fpcadanot438.xyz;
    client_max_body_size 0;

    # a server-level access_log replaces the inherited one, so keep the default log too
    access_log /var/log/nginx/access.log;
    access_log /var/log/nginx/cvat-auth-fail.log cvat_auth if=$cvat_auth_fail;

    location = /api/auth/register {
        return 403;
    }

    location ^~ /auth/register {
        return 302 /auth/login;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
