ubuntu@ip-172-31-23-184:~$ sudo cat /etc/nginx/sites-available/cvat.fpcadanot438.xyz
   server {
       server_name cvat.fpcadanot438.xyz;
       client_max_body_size 0;

       location = /api/auth/register {
           return 403;
       }

       location ^~ /auth/register {
           return 302 /auth/login;
       }

       location / {
           proxy_pass http://127.0.0.1:8080;
           proxy_http_version 1.1;
           proxy_set_header Host $host;
           proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
           proxy_set_header X-Forwarded-Proto $scheme;
           proxy_set_header Upgrade $http_upgrade;
           proxy_set_header Connection "upgrade";
           proxy_read_timeout 300s;
       }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/cvat.fpcadanot438.xyz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/cvat.fpcadanot438.xyz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
   server {
    if ($host = cvat.fpcadanot438.xyz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


       listen 80;
       server_name cvat.fpcadanot438.xyz;
    return 404; # managed by Certbot


}
